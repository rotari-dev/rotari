# rotari's shell integration for zsh: the user's .zshrc (see .zshenv), then the marks for the
# Web terminal's blocks (marks.zsh).
ZDOTDIR=$__rotari_user
[[ -r $ZDOTDIR/.zshrc ]] && source $ZDOTDIR/.zshrc
__rotari_user=$ZDOTDIR
ZDOTDIR=$__rotari_zdotdir

# The marks, from marks.zsh beside this directory; then ZDOTDIR as the user had it, so that
# a login zsh reads the user's .zlogin itself and a zsh started from this one the user's
# files, unless the marks say otherwise for it.
source ${ROTARI_SHELL_INTEGRATION:-${${(%):-%x}:A:h:h}}/marks.zsh
ZDOTDIR=$__rotari_user
if (( ! __rotari_had )) && [[ $ZDOTDIR == $HOME ]]; then
	unset ZDOTDIR
fi
unset __rotari_zdotdir __rotari_had __rotari_user
